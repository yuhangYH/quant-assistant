# Copy this file to .env and fill in your key(s).

# Required for `ask` and the web app.
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
QA_MODEL=claude-sonnet-5
QA_MAX_TOKENS=1500
QA_TOP_K=5
QA_INDEX=index.pkl

# Embeddings backend: auto | voyage | sentence-transformers | hashing
# auto = voyage (if VOYAGE_API_KEY set) -> sentence-transformers (if installed) -> hashing
EMBEDDINGS_BACKEND=auto
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3
